<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="10dp" android:background="@drawable/widget_background">
  <ImageView android:id="@+id/widget_icon" android:layout_width="48dp" android:layout_height="48dp"
      android:src="@drawable/vishal_jarvis_icon" android:contentDescription="Open Vishal Jarvis" />
  <TextView android:id="@+id/widget_talk" android:layout_width="0dp" android:layout_weight="1"
      android:layout_height="48dp" android:layout_marginStart="10dp" android:gravity="center"
      android:text="Hey Jarvis · Talk" android:textColor="#E1FAF8" android:textSize="16sp"
      android:textStyle="bold" android:background="@drawable/widget_button" />
</LinearLayout>
