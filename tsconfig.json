{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/mobile/**/*.ts", "src/lib/audio.ts", "shared/conversation.ts", "shared/character/commands.ts", "src/vite-env.d.ts", "tests/**/*.ts"]
}
